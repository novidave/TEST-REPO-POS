{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CACADUU Inventory",
  "version": "0.1.0",
  "identifier": "com.cacaduu.inventory",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "npm run tauri:prepare",
    "beforeBuildCommand": "npm run tauri:prepare"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; style-src 'self'; script-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Standalone inventory synchronization",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/cacaduu-node"],
    "resources": {
      "../build/tauri-backend/": "backend/"
    }
  }
}
