{
  "name": "cacaduu-pos-sync-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Electron POS export agent with optional CACADUU Cloud Connection",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.cjs",
    "sync:once": "npm run build && node dist/src/sync/cli.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "electron": "^35.0.0",
    "typescript": "^5.8.0",
    "@types/better-sqlite3": "^7.6.13"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1"
  }
}
